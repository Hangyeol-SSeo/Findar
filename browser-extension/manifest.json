{
  "manifest_version": 3,
  "name": "Findar 지원서 입력",
  "version": "1.2.0",
  "description": "현재 지원서의 빈 입력칸에 Findar에 저장한 정보를 채웁니다.",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["http://localhost/*", "http://127.0.0.1/*"], "js": ["connect.js"] }]
}
